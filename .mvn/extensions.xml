<extensions>
    <!-- https://maven.apache.org/extensions/maven-build-cache-extension/ -->
    <extension>
        <groupId>org.apache.maven.extensions</groupId>
        <artifactId>maven-build-cache-extension</artifactId>
        <version>1.2.0</version>
    </extension>

    <!-- mvn-lens: JFR-based Maven build profiler, writing target/mvnlens/report.html at the
         end of every session. https://github.com/mvn-perf/mvn-lens

         Only SNAPSHOTs are published so far, to the Maven Central snapshot repository
         (https://central.sonatype.com/repository/maven-snapshots/). Core extensions are
         resolved before the project POM is read, so that repository cannot be declared in
         pom.xml for this artifact: .mvn/pom.xml pre-resolves it into the local repository
         instead. See .mvn/pom.xml and .github/actions/mvn-lens-setup/action.yml.

         Pass -Dmvnlens.disabled=true to switch the profiler off for a single invocation. -->
    <extension>
        <groupId>io.github.mvn-perf</groupId>
        <artifactId>mvn-lens-extension</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </extension>
</extensions>